# Only the Node-side scripts read this file: `pnpm db:push` and `pnpm bootstrap`.
# The deployed app gets its vars from the Pages config at the repo root;
# `wrangler dev` reads server/.dev.vars (copy the three vars below into it).
#
# Supabase → Project Settings → Database → Connection string → Session pooler.
# The direct (db.<ref>.supabase.co) host is IPv6-only without the paid add-on.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# usernames (comma-separated) promoted to root by `pnpm bootstrap` — day-to-day
# admin grants happen in /admin, this is only the bootstrap
ADMIN_USERNAMES=

# R2 public bucket domain: objects are served straight off it, nothing is signed
R2_PUBLIC_BASE_URL=https://wntn-music.partner.dvxch.net
WEB_ORIGIN=https://music.wntn.one,https://music.wntn.ru
